enerated request token is required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Browser Origin does not match the configured service origin.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Order not found or owned by another client token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Request key or payment conflict; inspect the existing order before retrying.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Unpaid quote expired; request a new quote before signing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Request exceeds the 16 KiB body limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"The action refused the input; nothing is charged.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit reached; wait for Retry-After.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Temporarily unavailable; saved state is retained.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"components":{"securitySchemes":{"requestToken":{"type":"http","scheme":"bearer","bearerFormat":"64 hex characters","description":"Client-generated random 32-byte secret, retained across quotes/retries/status reads. No operator credential or registration is required. This identifies your orders; wallet signatures separately authorize payment. apiKey is a discovery alias for this same Bearer scheme."},"apiKey":{"$ref":"#/components/securitySchemes/requestToken"}},"schemas":{"Policy":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"action":{"type":"string","minLength":1,"max